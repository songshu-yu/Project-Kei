# QQ Open Platform bot credentials. Keep the real values in .env only.
QQBOT_APPID=
QQBOT_SECRET=

# The local Project Kei API that this bridge calls.
PROJECT_KEI_URL=http://127.0.0.1:8000

# Security first: only these C2C user_openid values may receive replies.
# Keep empty until the identifier has been obtained through an explicitly
# authorized binding workflow; ordinary unauthorized messages are not logged.
QQBOT_ALLOW_FROM=

# Explicit opt-in. It remains ineffective unless voice and QQ media readiness
# are both confirmed by the local control facade.
QQBOT_REPLY_WITH_VOICE=false
QQBOT_MEDIA_UPLOAD_CAPABILITY=unknown

# Optional: only change these for a QQ private/test environment.
QQBOT_API_BASE=https://api.bot.qq.com
QQBOT_TOKEN_BASE=https://bots.qq.com
QQBOT_REPLY_MAX_CHARS=1500
QQBOT_REQUEST_TIMEOUT_MS=45000
