# Copy this file to .env and fill in local values.
# Secret values are read by api.py but are never printed.

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional: improves paper tracking rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: avoids GitHub anonymous API rate limits.
GITHUB_TOKEN=

# Optional: Bilibili may return 412 without a fresh browser cookie.
# Copy these from your own logged-in browser cookies if needed.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=

# Optional: daily paper tracking uses a wider window because publishers can lag.
PAPER_LOOKBACK_HOURS=24
ARXIV_SINCE_HOURS=24
ARXIV_MAX_RETRIES=0
ARXIV_ENABLE_AUTHORS=true
ARXIV_DAILY_AUTHOR_LIMIT=39
ARXIV_AUTHOR_MAX_RESULTS=2
ARXIV_TRUST_ENV=true
SEMANTIC_SCHOLAR_MIN_INTERVAL=12
PAPER_ENABLE_SEMANTIC_SCHOLAR=true
PAPER_SEMANTIC_SCHOLAR_FALLBACK_ONLY=true
PAPER_SEMANTIC_SCHOLAR_AUTHOR_LIMIT=6
PAPER_SEMANTIC_SCHOLAR_MAX_RESULTS=10
PAPER_ENABLE_CROSSREF_DAILY_SCAN=true
PAPER_CROSSREF_MAX_PER_JOURNAL=8
BRIEFING_MAX_PAPERS=30
MONEY_RSS_TRUST_ENV=false

# Generated audio cleanup
AUDIO_CLEANUP_ENABLED=true
AUDIO_RETENTION_DAYS=3
VOICE_AUDIO_RETENTION_DAYS=3
BRIEFING_AUDIO_RETENTION_DAYS=7
MIC_TEST_RETENTION_DAYS=1
AUDIO_MAX_TOTAL_MB=500

ASR_URL=http://127.0.0.1:8010/asr/transcribe
# Optional local faster-whisper runtime. The voice/all launcher imports only
# these three non-secret names and never prints their values.
ASR_MODEL_PATH=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
TTS_HOST=127.0.0.1
TTS_PORT=9880

# Enable these only if this PowerShell/API process must go through v2rayN.
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
# ALL_PROXY=http://127.0.0.1:10809
# NO_PROXY=localhost,127.0.0.1
