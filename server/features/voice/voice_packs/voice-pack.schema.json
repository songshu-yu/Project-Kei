{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-kei.local/schemas/voice-pack-v1.json",
  "title": "Project Kei Voice Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "engine", "supported_languages",
    "gpt_checkpoint", "sovits_checkpoint", "reference_audio", "reference_text",
    "reference_language", "default_text_language"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "protocol_version"],
      "properties": {
        "provider": {"enum": ["gpt-sovits"]},
        "protocol_version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "supported_languages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 20}
    },
    "gpt_checkpoint": {"$ref": "#/$defs/asset"},
    "sovits_checkpoint": {"$ref": "#/$defs/asset"},
    "reference_audio": {"$ref": "#/$defs/asset"},
    "reference_text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reference_language": {"type": "string", "minLength": 1, "maxLength": 20},
    "default_text_language": {"type": "string", "minLength": 1, "maxLength": 20},
    "generation_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top_k": {"type": "integer"},
        "top_p": {"type": "number", "exclusiveMinimum": 0},
        "temperature": {"type": "number", "exclusiveMinimum": 0},
        "speed_factor": {"type": "number", "exclusiveMinimum": 0},
        "text_split_method": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 300},
        "author": {"type": "string", "minLength": 1, "maxLength": 300},
        "license": {"type": "string", "minLength": 1, "maxLength": 300},
        "redistribution": {"enum": ["allowed", "restricted", "unknown"]}
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "integrity"],
      "properties": {
        "path": {
          "type": "string", "minLength": 1, "maxLength": 240,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["sha256", "existence_only"]},
            "size_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "sha256"}}},
              "then": {"required": ["size_bytes", "sha256"]}
            },
            {
              "if": {"properties": {"mode": {"const": "existence_only"}}},
              "then": {"not": {"anyOf": [{"required": ["size_bytes"]}, {"required": ["sha256"]}]}}
            }
          ]
        }
      }
    }
  }
}
