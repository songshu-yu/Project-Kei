{
  "schema_version": 1,
  "id": "voice",
  "name": "语音公共契约与编排",
  "version": "1.0.9",
  "type": "in_process",
  "required": false,
  "core_compatibility": ">=1.0.0 <2.0.0",
  "entrypoint": "backend.register",
  "dependencies": [
    "conversation"
  ],
  "optional_dependencies": [
    "calendar"
  ],
  "conflicts": [],
  "api_namespaces": [
    "/api/v1/voice",
    "/api/v1/voice-control"
  ],
  "legacy_endpoints": [
    "/voice/health",
    "/voice/chat",
    "/voice/chat/stream",
    "/voice/audio",
    "/api/v1/voice-control/status",
    "/api/v1/voice-control/asr/start",
    "/api/v1/voice-control/asr/start-background",
    "/api/v1/voice-control/asr/stop",
    "/api/v1/voice-control/asr/model-directory/status",
    "/api/v1/voice-control/asr/model-directory/select",
    "/api/v1/voice-control/gpt-sovits/start",
    "/api/v1/voice-control/gpt-sovits/start-background",
    "/api/v1/voice-control/gpt-sovits/stop"
  ],
  "dashboard_entrypoint": "dashboard/index.js",
  "data_namespace": "voice",
  "permissions": [
    "local_state"
  ],
  "requires_restart": true
}
