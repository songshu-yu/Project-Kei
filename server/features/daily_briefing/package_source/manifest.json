{
  "schema_version": 1,
  "id": "daily_briefing",
  "name": "每日情报",
  "version": "1.0.2",
  "type": "in_process",
  "required": false,
  "core_compatibility": ">=1.0.0 <2.0.0",
  "entrypoint": "backend.register",
  "dependencies": [],
  "optional_dependencies": [
    "intel_sources",
    "x_monitor",
    "bilibili",
    "youtube",
    "github_intel",
    "papers",
    "rss_intel",
    "conversation",
    "voice"
  ],
  "conflicts": [],
  "api_namespaces": [
    "/api/v1/briefing"
  ],
  "legacy_endpoints": [
    "/briefing/today",
    "/briefing/today/voice",
    "/dashboard/briefing/generate",
    "/dashboard/briefing/status"
  ],
  "dashboard_entrypoint": "dashboard/index.js",
  "data_namespace": "daily_briefing",
  "permissions": [
    "local_state"
  ],
  "requires_restart": true
