{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-kei.local/schemas/module-manifest-v1.json",
  "title": "Project Kei installable module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "type", "required",
    "core_compatibility", "dependencies", "optional_dependencies", "conflicts",
    "api_namespaces", "legacy_endpoints", "data_namespace", "permissions",
    "requires_restart"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "type": {"enum": ["in_process", "sidecar"]},
    "required": {"type": "boolean"},
    "core_compatibility": {"type": "string", "minLength": 1, "maxLength": 160},
    "entrypoint": {"type": ["string", "null"], "minLength": 3, "maxLength": 160},
    "dependencies": {"$ref": "#/$defs/moduleIds"},
    "optional_dependencies": {"$ref": "#/$defs/moduleIds"},
    "runtime_requirements": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/runtimeRequirement"}
    },
    "conflicts": {"$ref": "#/$defs/moduleIds"},
    "api_namespaces": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/api/v1/"}
    },
    "legacy_endpoints": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "dashboard_entrypoint": {"type": ["string", "null"], "minLength": 1},
    "data_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "config_schema": {"type": ["string", "null"], "minLength": 1},
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["local_state", "network_download"]}
    },
    "requires_restart": {"type": "boolean"},
    "sidecar": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "healthcheck_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "in_process"}}},
      "then": {"required": ["entrypoint"], "properties": {"sidecar": false}}
    },
    {
      "if": {"properties": {"type": {"const": "sidecar"}}},
      "then": {"required": ["sidecar"]}
    }
  ],
  "$defs": {
    "moduleIds": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "runtimeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "supported_major_versions", "architecture"],
      "properties": {
        "id": {"enum": ["node"]},
        "supported_major_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 999}
        },
        "architecture": {"const": "x64"}
      }
    }
  }
}
