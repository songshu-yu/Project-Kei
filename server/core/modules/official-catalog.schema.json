{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-kei.local/schemas/official-module-catalog-v1.json",
  "title": "Project Kei official module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publisher", "owner", "repository", "generated_at", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "publisher": {"const": "Project Kei"},
    "owner": {"const": "songshu-yu"},
    "repository": {"const": "Project-Kei-Modules"},
    "generated_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id", "name", "version", "core_compatibility",
          "manifest_sha256", "package_url", "package_size", "package_sha256",
          "release_tag", "asset_name", "dependencies", "optional_dependencies",
          "conflicts", "permissions", "data_policy", "requires_restart"
        ],
        "properties": {
          "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "version": {"type": "string", "minLength": 1, "maxLength": 80},
          "core_compatibility": {"type": "string", "minLength": 1, "maxLength": 160},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "package_url": {"type": "string", "format": "uri"},
          "package_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "package_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "release_tag": {"type": "string", "pattern": "^[0-9A-Za-z._-]{1,120}$"},
          "asset_name": {"type": "string", "pattern": "^[0-9A-Za-z._-]{1,160}\\.zip$"},
          "dependencies": {"$ref": "#/$defs/moduleIds"},
          "optional_dependencies": {"$ref": "#/$defs/moduleIds"},
          "runtime_requirements": {"$ref": "#/$defs/runtimeRequirements"},
          "conflicts": {"$ref": "#/$defs/moduleIds"},
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["local_state", "network_download"]}
          },
          "data_policy": {"const": "preserve_on_uninstall"},
          "requires_restart": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "moduleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "runtimeRequirements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "supported_major_versions", "architecture"],
        "properties": {
          "id": {"enum": ["node"]},
          "supported_major_versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 999}
          },
          "architecture": {"const": "x64"}
        }
      }
    }
  }
}
